# Database Configuration
DATABASE_URL=postgresql://quant_user:your_password@localhost:5432/quant_db
POSTGRES_USER=quant_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=quant_db

# API Keys
FINMIND_API_TOKEN=your_finmind_token
FINNHUB_API_KEY=your_finnhub_key

# FRED API (US Macro Economic Data - free at https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_key

# Application Settings
DEBUG=false
LOG_LEVEL=INFO
